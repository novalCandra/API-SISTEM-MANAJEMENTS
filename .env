# ==== Runtime ====
NODE_ENV=development
PORT=3000
# Comma separated allowlist for CORS
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000

# ==== JWT / Auth ====
# Use: openssl rand -base64 48   (must be >= 32 bytes)
JWT_ACCESS_SECRET=7j6RS4jhrxaQuFXinuvrT+fy8R8dBf2W6NrJHDExBYRsSw2NXBblmmCtSjhzw75v
JWT_REFRESH_SECRET=GVuV6YPbAa17SW2VMHRwL2WxD6yvxCo6llxU/T8if+PPXyoEQ5ZglIwWK1I4zQg3
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_NAME=stokku_rt
COOKIE_DOMAIN=
# Set to true (and serve over HTTPS) in production
COOKIE_SECURE=false
# Comma separated list of allowed browser origins for cookies, or "lax"/"strict"/"none"
COOKIE_SAMESITE=strict

# ==== Data drivers ====
# memory | firestore | rtdb
DB_DRIVER=rtdb
# local | firebase
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# ==== Realtime ====
# socket : event realtime dikirim langsung lewat Socket.IO (default, cocok untuk dev lokal)
# rtdb   : event realtime ditulis ke Firebase Realtime Database lalu di-bridge
#          ke Socket.IO (lintas instance / multi-server)
REALTIME_DRIVER=rtdb
FIREBASE_DATABASE_URL=https://productfatchers-default-rtdb.firebaseio.com
# Berapa lama event realtime disimpan sebelum dibersihkan otomatis (ms)
RTDB_EVENT_TTL_MS=900000
# Interval pembersihan event realtime (ms)
RTDB_CLEANUP_INTERVAL_MS=300000

# ==== Rate limits ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=30

# ==== Firebase (required when DB_DRIVER=firestore/rtdb, STORAGE_DRIVER=firebase,
#      or REALTIME_DRIVER=rtdb) ====
# Option A: path to a service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccountKey.json
# Option B: inline credentials
FIREBASE_PROJECT_ID=productfatchers
FIREBASE_CLIENT_EMAIL=
# Keep the \n escapes in the private key
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=productfatchers.appspot.com

# ==== Firebase Emulator (local, tanpa kredensial) ====
# Jalankan: npm run emulators   (butuh firebase-tools + Java untuk emulator database)
# FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# STORAGE_EMULATOR_HOST=127.0.0.1:9199
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# GCLOUD_PROJECT=demo-stokku

# ==== Logging ====
LOG_LEVEL=debug
